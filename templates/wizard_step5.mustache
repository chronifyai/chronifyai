{{!
    @template local_chronifyai/wizard_step5

    ChronifyAI setup wizard - Completion page (Step 5)

    Example context (json):
    {
        "step_title": "You're All Set!",
        "dashboard_url": "https://app.chronifyai.com"
    }
}}

<div class="chronifyai-text-content">
    <h2 class="chronifyai-completion-title">{{step_title}}</h2>

    <div class="chronifyai-success-icon">✓</div>

    <p class="chronifyai-completion-message">
        {{#str}}wizard:step5:message, local_chronifyai{{/str}}
    </p>

    <div class="chronifyai-cta-section">
        <a href="{{dashboard_url}}" class="chronifyai-btn-continue" target="_blank">
            {{#str}}wizard:step5:dashboard, local_chronifyai{{/str}}
        </a>
    </div>
</div>
