{{!
    @template local_chronifyai/wizard_step3

    ChronifyAI setup wizard - Feature Configuration (Step 3)

    Example context (json):
    {
        "form": "<form>Feature configuration form HTML</form>"
    }
}}

<div class="chronifyai-text-content">
    <h2 class="chronifyai-section-title">{{#str}}wizard:step3:title, local_chronifyai{{/str}}</h2>
    <p class="chronifyai-section-description">
        {{#str}}wizard:step3:description, local_chronifyai{{/str}}
    </p>

    <div class="chronifyai-form-container">
        {{{form}}}
    </div>

    <div class="chronifyai-nav-buttons">
        <a href="{{previous_url}}" class="chronifyai-btn-previous">
            {{#str}}ui:button:previous, local_chronifyai{{/str}}
        </a>
    </div>
</div>
